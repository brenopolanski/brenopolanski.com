{
  "name": "brenopolanski.com",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "description": "Breno Polanski's personal website",
  "repository": {
    "type": "git",
    "url": "git@github.com:brenopolanski/brenopolanski.com.git"
  },
  "license": "MIT",
  "author": {
    "name": "Breno Polanski",
    "email": "breno@brenopolanski.com",
    "url": "https://github.com/brenopolanski"
  },
  "portless": {
    "name": "personal-website",
    "script": "dev:next"
  },
  "scripts": {
    "build": "next build",
    "check:fix": "bun format && bun lint:fix && bun typecheck",
    "clean": "/bin/bash scripts/clean.sh",
    "dev": "portless",
    "dev:next": "next dev --turbopack",
    "email": "portless run --name personal-emails --script email:dev",
    "email:dev": "email dev --dir src/emails --port $PORT",
    "format": "bun prettier --write",
    "format:check": "bun prettier --check",
    "lint": "eslint .",
    "lint:fix": "bun lint --fix",
    "lint-staged": "lint-staged",
    "preinstall": "npx only-allow bun",
    "prepare": "husky",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,css,json,md}\"",
    "resume:build": "/bin/bash scripts/resume-build.sh",
    "resume:validate": "/bin/bash scripts/resume-validate.sh",
    "start": "portless --script start:next",
    "start:next": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/components": "^1.0.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "env.style": "^1.0.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.3",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@react-email/ui": "6.9.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "portless": "^0.15.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2"
  }
}
