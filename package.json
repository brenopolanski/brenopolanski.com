{
  "name": "brenopolanski.com",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Breno Polanski's personal website",
  "repository": {
    "type": "git",
    "url": "git@github.com:brenopolanski/brenopolanski.com.git"
  },
  "license": "MIT",
  "author": {
    "name": "Breno Polanski",
    "email": "breno@brenopolanski.com",
    "url": "https://github.com/brenopolanski"
  },
  "portless": {
    "name": "personal-website",
    "script": "dev:next"
  },
  "scripts": {
    "build": "next build",
    "check:fix": "bun format && bun lint:fix && bun typecheck",
    "clean": "/bin/bash scripts/clean.sh",
    "dev": "portless",
    "dev:next": "next dev --turbopack",
    "email": "email dev --dir src/emails --port 3001",
    "format": "bun prettier --write",
    "format:check": "bun prettier --check",
    "lint": "next lint",
    "lint:fix": "bun lint --fix",
    "lint-staged": "lint-staged",
    "preinstall": "npx only-allow bun",
    "prepare": "husky",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,css,json,md}\"",
    "start": "portless --script start:next",
    "start:next": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@react-email/components": "^0.0.34",
    "@vercel/og": "^0.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.482.0",
    "motion": "^12.5.0",
    "next": "15.5.21",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^3.0.7",
    "resend": "^4.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/circular-dependency-plugin": "^5.0.8",
    "@types/node": "^20",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "circular-dependency-plugin": "^5.2.2",
    "eslint": "^9",
    "eslint-config-next": "15.2.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.2",
    "portless": "^0.15.5",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
