# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# env.style (generated tinted favicons)
/public/__envstyle/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files
.env
.env*.local

# resume (build artifacts, including the generated pt-BR resume; resume.yml is
# the general source, resume_frontend.yml is the front-end source, and
# translations.pt-BR.yml is the general resume's pt-BR wording)
/resume/*
!/resume/resume.yml
!/resume/resume_frontend.yml
!/resume/translations.pt-BR.yml

# misc
*.tsbuildinfo
.eslintcache
.cache/
.husky/_
next-env.d.ts
